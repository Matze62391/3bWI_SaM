{
  "schemaVersion": 1,
  "id": "guideme",
  "version": "${version}",
  "name": "GuideME",
  "description": "A library for in-game guidebooks, used by Applied Energistics 2. Unofficial Fabric port.",
  "authors": ["TeamAppliedEnergistics"],
  "contact": {
    "sources": "https://github.com/AppliedEnergistics/GuideME"
  },
  "license": "LGPL-3.0-only",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["guideme.internal.GuideME"],
    "client": ["guideme.internal.GuideMEClient"]
  },
  "mixins": ["guideme.mixins.json", "guideme.optional.mixins.json"],
  "accessWidener": "guideme.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
